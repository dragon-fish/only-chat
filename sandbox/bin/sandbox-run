#!/usr/bin/env bash
# Foreground wrapper: sandbox-run <logfile> <pidfile> <timeout_seconds> -- <command...>
# stdin passes through untouched; stdout/stderr are teed into <logfile>.
# GNU timeout moves itself into its own process group (pid == pgid) and signals
# the whole group, so the pidfile value works as `kill -TERM -- -<pid>`.
set -u

if [ "$#" -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: sandbox-run <logfile> <pidfile> <timeout_seconds> -- <command...>" >&2
  exit 2
fi

log=$1 pidfile=$2 secs=$3
shift 4

mkdir -p -- "$(dirname -- "$log")" "$(dirname -- "$pidfile")"

# Both streams are appended to the same file in arrival order. The tee
# processes are waited for before exit so nothing is lost to buffering.
exec 3>&1 4>&2
exec 1> >(tee -a -- "$log" >&3)
tee_out=$!
exec 2> >(tee -a -- "$log" >&4)
tee_err=$!

# A background job would get /dev/null as stdin; <&0 keeps the real one.
timeout --kill-after=5s "${secs}s" "$@" <&0 &
child=$!
printf '%s\n' "$child" > "$pidfile"
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP

# The shell reports signal deaths on its own stderr; keep that out of the log.
{ wait "$child"; } 2>/dev/null
status=$?
while kill -0 "$child" 2>/dev/null; do { wait "$child"; } 2>/dev/null; status=$?; done
trap - TERM INT HUP

# Close our ends so each tee sees EOF, then wait for it to flush.
exec 1>&3 2>&4 3>&- 4>&-
wait "$tee_out" "$tee_err" 2>/dev/null
exit "$status"
