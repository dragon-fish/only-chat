{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "only-chat",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["KEY_ENCRYPTION_SECRET"] },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.epb.wiki", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "only-chat-db",
      "database_id": "48da2d06-2a1a-4b1d-bb89-a4627a26e0ae",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "only-chat-attachments" }],
  "kv_namespaces": [{ "binding": "KV", "id": "cdbd1aa741cb4b77b12564f1e1274bb9" }],
  // Daily catalog refresh and independent expired provider file pointer sweep.
  "triggers": { "crons": ["0 3 * * *"] }
}
